# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where form submissions are delivered
CONTACT_TO_EMAIL=info@easybreathwork.com

# Must be a verified sender/domain in Resend.
# For local testing you can use: Easy Breathwork <onboarding@resend.dev>
# (onboarding@resend.dev only delivers to the Resend account owner's email)
CONTACT_FROM_EMAIL=Easy Breathwork <onboarding@resend.dev>

# Public site URL used for sitemap, canonicals, Open Graph, and llms.txt
NEXT_PUBLIC_SITE_URL=https://easybreathwork.com

# Optional: Google Search Console HTML tag verification code
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
